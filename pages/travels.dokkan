@dokkan 0.0.0
@import main::"template.dokkan"

@def TravelList($base: string) = ul.travels {
  @def Travel($id: string) = li {
    a[role="button" command="show-modal" commandfor=$"lb{$id}" href=$"{$base}/i{$id}.jpeg"] {
      img.thumb[src=$"{$base}/t{$id}.jpeg" width=128]
    }
    dialog.lightbox[id=$"lb{$id}"] {
      button.close[command="close" commandfor=$"lb{$id}"] {
        "Close"
      }
      img[src=$"{$base}/i{$id}.jpeg"]
    }
  }
  Travel($i | %5d) @for($i : 0 .. 115)
}

@def TravelsPage($title: string, $path: string) = main::Main("travels", $title) {
  @yield

  TravelList($path)

  script[type="module" src="/travels.js" async]
}