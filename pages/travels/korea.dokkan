@dokkan 0.0.0
@import main::"../template.dokkan"

@def TravelList($base: string) = ul.travels {
  @def Travel($id: string) = li {
    a[role="button" command="show-modal" commandfor=$id href=$"{$base}/{$id}.jpeg" data-opens-modal=$id] {
      img.thumb[src=$"{$base}/{$id}_thumb.jpeg" width=128]
    }
    dialog.lightbox[$id] {
      button.close[command="close" commandfor=$id] {
        "Close"
      }
      img[src=$"{$base}/{$id}.jpeg"]
    }
  }
  Travel("IMG_8175")
  Travel("IMG_8176")
